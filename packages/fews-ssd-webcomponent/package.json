{
  "name": "@deltares/fews-ssd-webcomponent",
  "version": "2.0.0",
  "private": false,
  "description": "Web component for FEWS Schematic Status Display",
  "keywords": [
    "FEWS",
    "Schematic Status Display web component"
  ],
  "bugs": {
    "url": "https://github.com/Deltares/fews-ssd-requests/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Werner Kramer",
    "email": "werner.kramer@deltares.nl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Deltares/fews-ssd-requests.git",
    "directory": "packages/fews-ssd-webcomponent"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/fews-ssd-webcomponent/fews-ssd-webcomponent.esm.js",
  "exports": {
    ".": {
      "import": "./dist/fews-ssd-webcomponent/fews-ssd-webcomponent.esm.js",
      "require": "./dist/fews-ssd-webcomponent/fews-ssd-webcomponent.cjs.js"
    },
    "./schematic-status-display": {
      "import": "./dist/components/schematic-status-display.js",
      "types": "./dist/components/schematic-status-display.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "rc"
  },
  "scripts": {
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vp test run --config vitest.config.mts --project unit",
    "test:e2e": "vp test run --config vitest.config.mts --project browser",
    "test.watch": "vp test watch --config vitest.config.mts --project unit",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@deltares/fews-pi-requests": "^4.0.0-rc.0",
    "@deltares/fews-ssd-requests": "^2.0.0-rc.3",
    "@stencil/core": "^4.45.4"
  },
  "devDependencies": {
    "@stencil/vitest": "^1.16.2",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "*",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js"
}
