{
  "name": "@deltares/fews-ssd-requests",
  "version": "2.0.0-rc.8",
  "description": "Library for making requests to the FEWS SSD webservice",
  "author": {
    "name": "Werner Kramer",
    "email": "werner.kramer@deltares.nl"
  },
  "keywords": [
    "FEWS",
    "Schematic Status Display Service"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "module": "./dist/fews-ssd-requests.js",
  "exports": {
    ".": {
      "import": "./dist/fews-ssd-requests.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "doc": "typedoc --out doc src",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e --config vitest.config.e2e.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "json2ts": "node scripts/generateTypes.js ssd",
    "sonar": "sonar-scanner -Dsonar.host.url=$SONAR_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.projectKey=$SONAR_KEY -Dsonar.projectName='Delft-FEWS Web OC SSD Requests'"
  },
  "dependencies": {
    "@deltares/fews-web-oc-utils": "^2.1.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "json-schema-to-typescript": "^15.0.4",
    "sonarqube-scanner": "5.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deltares/fews-ssd-requests.git",
    "directory": "packages/fews-ssd-requests"
  },
  "bugs": {
    "url": "https://github.com/Deltares/fews-ssd-requests/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc",
    "registry": "https://registry.npmjs.org"
  }
}
